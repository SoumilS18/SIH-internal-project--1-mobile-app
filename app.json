{
  "expo": {
    "name": "AgriOptima AI",
    "slug": "agrioptima-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "agrioptima",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.agrioptima.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AgriOptima uses your farm location to fetch hyper-local agro-climatic intelligence and soil risk alerts.",
        "NSMicrophoneUsageDescription": "AgriOptima uses the microphone for Indic voice interaction with the Farm Advisory AI."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B4332"
      },
      "package": "ai.agrioptima.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgriOptima uses your location to provide accurate local weather and agro-climatic advisories."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "AgriOptima needs microphone access for voice queries in Hindi and regional languages."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B4332"
        }
      ],
      [
        "expo-updates",
        {
          "username": "soumils18"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2a4ef2d7-57dc-41b7-aa63-1724a63fb261",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "soumils18",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2a4ef2d7-57dc-41b7-aa63-1724a63fb261"
      }
    }
  }
}
