# =============================================================================
# AgriOptima AI Mobile App - Environment Configuration Template
# =============================================================================
#
# DO NOT commit real keys to version control.
# Copy this file to '.env' and fill in your Supabase & Backend API URLs.

# -----------------------------------------------------------------------------
# 1. CLIENT-SAFE PUBLIC CREDENTIALS (Expo Public Environment Variables)
# -----------------------------------------------------------------------------
# Supabase Project URL and Public Anon Key (Found in Supabase Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Backend REST API endpoint (Points to local Python backend or deployed cloud server)
# Note for Android Emulator: use http://10.0.2.2:8000
# Note for Physical Phone on same WiFi: use http://<your-computer-ip>:8000
# Note for Web / Production: use your deployed URL (e.g. https://api.agrioptima.ai)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# 2. SECURITY NOTICE:
# -----------------------------------------------------------------------------
# NEVER put private keys (GEMINI_API_KEY, SARVAM_API_KEY, SUPABASE_SERVICE_ROLE_KEY)
# in this mobile client application. Private API calls MUST be handled through
# the secure backend server.
